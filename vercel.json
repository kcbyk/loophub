{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/loops/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/loops/:match*",
      "destination": "/public/loops/:match*"
    },
    {
      "source": "/data/:match*",
      "destination": "/public/data/:match*"
    },
    {
      "source": "/:match*",
      "destination": "/public/:match*"
    }
  ]
}
